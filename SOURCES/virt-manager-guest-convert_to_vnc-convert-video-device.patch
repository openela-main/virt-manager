   <devices>
     <graphics type="vnc" port="-1"/>
+    <video>
+      <model type="vga"/>
+    </video>
   </devices>
 </domain>
diff --git a/tests/data/xmlparse/convert-to-vnc-has-vnc-in.xml b/tests/data/xmlparse/convert-to-vnc-has-vnc-in.xml
